# Copy this file to ".env" for local development.
# For production (Render), set these in the Render dashboard instead.

# Local development uses a SQLite file by default — leave these unset locally.
# For production, set DATABASE_URL + DATABASE_AUTH_TOKEN to your Turso database.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Port the API server listens on (Render sets this automatically)
PORT=3001

# Secret used to sign login (JWT) tokens — use a long random string in production
SESSION_SECRET=barangay-local-dev-secret-change-in-production

NODE_ENV=development

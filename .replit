modules = ["nodejs-24"]

# Legacy fallback run command (the workflow below is what the Run button uses)
run = "pnpm install --filter \"@workspace/api-server...\" --no-frozen-lockfile && PORT=8080 pnpm --filter @workspace/api-server run start:prod"

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Expose the server (port 8080) on the public web port (80) -> your replit.dev link
[[ports]]
localPort = 8080
externalPort = 80

# ── Run button workflow ──────────────────────────────────────────────────────
# Replit keeps this process alive and connects the preview/public URL to port 8080.
# Installs only the API server + its deps (light), then starts the server which also
# serves the pre-built website. waitForPort tells Replit to proxy once 8080 is up.
[workflows]
runButton = "Start App"

[[workflows.workflow]]
name = "Start App"
mode = "sequential"
author = 0

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --filter \"@workspace/api-server...\" --no-frozen-lockfile && PORT=8080 pnpm --filter @workspace/api-server run start:prod"
waitForPort = 8080

# Used only if you ever upgrade to paid Replit Deployments (free tier ignores this)
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/admin-web run build"]
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start:prod"]

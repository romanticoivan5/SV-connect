modules = ["nodejs-24"]

# When you press "Run": install ONLY the API server + its deps (lightweight, free-tier
# friendly), then start. The website is pre-built and committed, and the API server
# serves it, so everything runs at ONE URL with no heavy build step on Replit.
run = "pnpm install --filter \"@workspace/api-server...\" --no-frozen-lockfile && PORT=8080 pnpm --filter @workspace/api-server run start:prod"

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Expose the server (port 8080) on the public web port (80) -> your replit.dev link
[[ports]]
localPort = 8080
externalPort = 80

# Used only if you ever upgrade to paid Replit Deployments (free tier ignores this)
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/admin-web run build"]
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start:prod"]

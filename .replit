modules = ["nodejs-24"]

# When you press "Run": install deps, build the website, then start the server.
# The API server also serves the built website, so everything runs at ONE URL.
run = "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/admin-web run build && PORT=8080 pnpm --filter @workspace/api-server run start:prod"

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Expose the server (port 8080) on the public web port (80) -> your replit.dev link
[[ports]]
localPort = 8080
externalPort = 80

# Used only if you ever upgrade to paid Replit Deployments (free tier ignores this)
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/admin-web run build"]
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start:prod"]

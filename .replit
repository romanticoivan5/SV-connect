modules = ["nodejs-24"]

# Legacy fallback (the workflow below is what the Run button uses)
run = "pnpm install --filter \"@workspace/api-server...\" --no-frozen-lockfile && NODE_ENV=production PORT=8080 pnpm --filter @workspace/api-server run start:prod"

[nix]
channel = "stable-25_05"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Expose the server (port 8080) on the public web port (80) -> your replit.dev link
[[ports]]
localPort = 8080
externalPort = 80

# ── Run button workflow ──────────────────────────────────────────────────────
# Runs the API server with tsx (handles libsql's native engine correctly).
# NODE_ENV=production disables the pino-pretty worker. Replit keeps this process
# alive and routes the public URL to port 8080 (waitForPort).
[workflows]
runButton = "Start App"

[[workflows.workflow]]
name = "Start App"
mode = "sequential"
author = 0

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --filter \"@workspace/api-server...\" --no-frozen-lockfile && NODE_ENV=production PORT=8080 pnpm --filter @workspace/api-server run start:prod"
waitForPort = 8080

# Used only if you ever upgrade to paid Replit Deployments (free tier ignores this)
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/admin-web run build"]
run = ["sh", "-c", "NODE_ENV=production pnpm --filter @workspace/api-server run start:prod"]
